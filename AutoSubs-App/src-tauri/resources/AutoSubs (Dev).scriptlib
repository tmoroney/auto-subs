-- AUTO-GENERATED DEV AUTO-STARTER.
--
-- Generated by `npm run setup-resolve` from the template in
-- src-tauri/resources/AutoSubs (Dev).scriptlib. Resolve runs any *.scriptlib
-- file in the ROOT of the Fusion/Scripts folder at startup, so this launches
-- the dev AutoSubs bridge (pointing at your repo checkout) automatically when
-- Resolve opens — no need to run Workspace → Scripts → AutoSubs (Dev) unless
-- you want to restart it.
--
-- The real work is handed to fusion:Execute(), which runs the bootstrap
-- asynchronously in another scripting state, so Resolve's startup is never
-- blocked. The whole body is pcall'd so a failure is silent.
--
---@diagnostic disable: undefined-global
pcall(function()
    local resources_folder = [[__AUTOSUBS_RESOURCES_FOLDER__]]

    if resources_folder == "__AUTOSUBS_RESOURCES_FOLDER__" then
        return -- not generated yet; stay silent inside the startup pcall
    end

    local bootstrap_path = resources_folder .. "/modules/bootstrap.lua"
    if not bmd.fileexists(bootstrap_path) then
        return -- repo moved or not set up; stay silent
    end

    (fusion or fu):Execute(string.format(
        'local boot = assert(loadfile(%q))(); boot(%q, %q, true, { mode = "startup" })',
        bootstrap_path, resources_folder, ""))
end)
