-- AutoSubs bridge auto-starter.
--
-- DaVinci Resolve runs any *.scriptlib file placed in the ROOT of the
-- user-level Fusion/Scripts folder once at startup. We use that to start the
-- AutoSubs bridge with zero clicks: instead of running the loop here (which
-- would block Resolve's startup), we hand the real launcher to
-- fusion:Execute(), which runs it asynchronously in another scripting state.
-- The bridge loop then lives there as a resident server until Resolve quits
-- or the Utility > AutoSubs script restarts it (mode = "manual" takeover).
--
-- This file is a TEMPLATE. The AutoSubs app itself writes the installed copy
-- on startup (resolve_scripts.rs), baking the real install paths into the
-- [[...]] placeholders below.
--
-- The whole body is pcall'd so a failure can never break Resolve's startup.
--
---@diagnostic disable: undefined-global
pcall(function()
    local resources_folder = [[__AUTOSUBS_RESOURCES_FOLDER__]]
    local app_executable = [[__AUTOSUBS_APP_EXECUTABLE__]]

    local bootstrap_path = resources_folder .. "/modules/bootstrap.lua"
    if not bmd.fileexists(bootstrap_path) then
        return -- app not installed
    end

    (fusion or fu):Execute(string.format(
        'local boot = assert(loadfile(%q))(); boot(%q, %q, false, { mode = "startup" })',
        bootstrap_path, resources_folder, app_executable))
end)
