TAURI_SIGNING_PRIVATE_KEY=your-tauri-signing-private-key-here
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=your-tauri-signing-private-key-password-here

# Anonymous usage telemetry, official release builds only. Without all three
# values `option_env!` yields None, telemetry is compiled out entirely, and the
# app shows no consent prompt (see src-tauri/src/telemetry.rs and PRIVACY.md),
# which is what you want for development and for builds from a fork.
#
# CI passes the same three via GitHub secrets in .github/workflows/package.yml.
# The key must match an entry in the Worker's SIGNING_KEYS map for the version
# being built; rotate it per release (see telemetry-worker/README.md).
AUTOSUBS_TELEMETRY_URL=https://telemetry.example.workers.dev/v1/usage
AUTOSUBS_TELEMETRY_KEY=your-per-release-hex-signing-key-here
AUTOSUBS_BUILD_CHANNEL=release
