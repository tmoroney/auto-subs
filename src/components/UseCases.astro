---
const cases = [
  {
    title: "Social and YouTube",
    body: "Burned-in captions styled to match your channel, generated in the time it takes to make coffee. Most views arrive on mute.",
  },
  {
    title: "Subtitling and translation",
    body: "Transcribe in one language, translate into another, and export SRT for every version of the cut you need to deliver.",
  },
  {
    title: "Interviews and documentary",
    body: "Speaker labels across long multi-person recordings, with word-level timing for paper edits and pull quotes.",
  },
];
---

<section class="border-t border-line py-24 md:py-32">
  <div class="shell">
    <h2 class="reveal text-section font-semibold leading-tight">What people use it for</h2>

    <div class="mt-14 grid gap-12 md:grid-cols-3 md:gap-10">
      {cases.map((item, i) => (
        <article class="reveal">
          <span class="text-sm font-semibold tabular-nums text-accent">
            {String(i + 1).padStart(2, "0")}
          </span>
          <h3 class="mt-3 text-xl font-semibold">{item.title}</h3>
          <p class="mt-3 leading-relaxed text-ink-2">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
